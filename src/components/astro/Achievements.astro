---
const { bg = "bg-ivory" } = Astro.props;
import FadeIn from "../react/FadeIn";
import Icon from "./Icon.astro";
import Watermark from "./Watermark.astro";
import { oldSite, logoFile } from "../../lib/media";
import list from "../../data/old-site-images.json";

const seal = oldSite(list.acrSeal);
const cert = oldSite(list.certificate);

// Drop official logo files into /public/images/logos named acr, mount-sinai-west, acog (svg/png/webp)
const badges = [
  { key: "acr", name: "ACR Accredited", sub: "American College of Radiology", note: "The gold standard in medical imaging. Our ultrasound meets the highest standards for image quality, safety and accuracy.", file: logoFile("acr") },
  { key: "mount-sinai-west", name: "Mount Sinai West", sub: "Hospital affiliation", note: "Both of our doctors are affiliated with Mount Sinai West, so your care continues smoothly when you deliver.", file: logoFile("mount-sinai-west") },
  { key: "acog", name: "ACOG · FACOG", sub: "American College of Obstetricians and Gynecologists", note: "Dr. Roesner and Dr. Fahmy are board-certified and hold Fellow (FACOG) status.", file: logoFile("acog") },
];
---
<section class={`section ${bg}`}>
  <Watermark class="-left-24 bottom-0 h-[460px] w-[680px] rotate-[-6deg]" />
  <div class="container-x">
    <FadeIn client:visible className="mx-auto max-w-2xl text-center">
      <p class="eyebrow eyebrow-center">Our achievements</p>
      <h2 class="h2 mt-5">Recognized for the standard we keep</h2>
    </FadeIn>

    <div class="mt-16 grid items-stretch gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <FadeIn client:visible>
        <div class="group relative h-full rounded-[2rem] bg-gradient-to-br from-clay to-espresso p-8 text-white shadow-soft transition-shadow duration-500 hover:shadow-lift md:p-10">
          <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[2rem]"><div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-gold/20 blur-3xl transition-all duration-700 group-hover:scale-125"></div></div>
          <p class="eyebrow text-gold-soft">ACR Gold Seal</p>
          <h3 class="mt-4 font-display text-3xl">Ultrasound accreditation</h3>
          <p class="mt-3 text-white/75">The ACR has accredited tens of thousands of imaging facilities since 1987. We are proud to be one of them.</p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <img src={seal} alt="ACR ultrasound gold seal of accreditation" class="img-square bg-white object-contain p-4 transition-transform duration-500 group-hover:-rotate-2" loading="lazy" />
            <div class="relative">
              <img
                src={cert}
                alt="ACR accreditation certificate for Aster OB/GYN"
                class="img-square object-cover object-top transition-all duration-500 ease-out lg:cursor-zoom-in lg:origin-bottom-right lg:hover:relative lg:hover:z-50 lg:hover:scale-[1.9] lg:hover:shadow-2xl"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </FadeIn>

      <div class="grid gap-5">
        {badges.map((b, i) => (
          <FadeIn client:visible delay={i * 0.1}>
            <article class="group flex items-center gap-6 rounded-3xl border border-sand/70 bg-white p-6 transition-all duration-500 hover:-translate-y-1 hover:border-terracotta/40 hover:shadow-soft">
              <div class="grid h-28 w-28 shrink-0 place-items-center rounded-2xl bg-blush p-3 transition-colors duration-300 group-hover:bg-terracotta/10">
                {b.file ? (
                  <img src={b.file} alt={`${b.name} logo`} class="max-h-full max-w-full object-contain" loading="lazy" />
                ) : (
                  <span class="text-center font-display text-lg font-semibold leading-tight text-terracotta-deep">
                    <Icon name="award" size={26} class="mx-auto mb-1" />
                    {b.name}
                  </span>
                )}
              </div>
              <div>
                <h3 class="font-display text-2xl">{b.name}</h3>
                <p class="text-sm font-semibold uppercase tracking-wider text-taupe">{b.sub}</p>
                <p class="mt-2 text-base text-espresso/75">{b.note}</p>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </div>
</section>
