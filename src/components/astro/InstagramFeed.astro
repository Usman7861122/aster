---
// Static Instagram showcase of real @asterobgyn posts (images saved locally, each tile links to its post).
import FadeIn from "../react/FadeIn";
import InstagramCarousel from "../react/InstagramCarousel";
import Icon from "./Icon.astro";
import { site } from "../../data/site";

const base = "https://www.instagram.com/asterobgyn";
// Latest posts from @asterobgyn. To refresh, replace the image in /public/images/instagram and the link id.
const posts = [
  { img: "/images/instagram/post-1.jpg", href: `${base}/p/DfGXV0nuO8p/`, alt: "Instagram post: HPV is extremely common", caption: "HPV is extremely common" },
  { img: "/images/instagram/post-2.jpg", href: `${base}/reel/DfUeG5bBADT/`, alt: "Instagram reel: the pelvic floor, the muscles you don't think about", caption: "The pelvic floor" },
  { img: "/images/instagram/post-3.jpg", href: `${base}/p/DfKK8WzjuI_/`, alt: "Instagram post: what is a Pap smear actually looking for?", caption: "What a Pap smear looks for" },
  { img: "/images/instagram/post-4.jpg", href: `${base}/p/DfGV8HYumKm/`, alt: "Instagram post: the HPV vaccine isn't just for kids", caption: "The HPV vaccine isn't just for kids" },
  { img: "/images/instagram/post-5.jpg", href: `${base}/reel/DerJ4v0BATq/`, alt: "Instagram reel: why do I pee when I laugh?", caption: "Why do I pee when I laugh?" },
  { img: "/images/instagram/post-6.jpg", href: `${base}/p/DepdPJjBN_5/`, alt: "Instagram reel about fibroids", caption: "Fibroids" },
];
---
<section id="instagram" class="section bg-white">
  <div class="container-x">
    <FadeIn client:visible className="mx-auto max-w-2xl text-center">
      <p class="eyebrow eyebrow-center">Follow along</p>
      <h2 class="h2 mt-5">Life at Aster, on Instagram</h2>
      <p class="mt-5 text-espresso/75">Helpful tips and honest answers on women's health, from our team.</p>
      <a href={site.instagram} target="_blank" rel="noopener" class="btn btn-primary btn-glow mt-8">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
        Follow {site.instagramHandle}
      </a>
    </FadeIn>

    <div class="mt-10">
      <InstagramCarousel client:visible posts={posts} />
    </div>
  </div>
</section>
