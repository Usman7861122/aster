---
import FadeIn from "../react/FadeIn";
import Icon from "./Icon.astro";
import Watermark from "./Watermark.astro";

const facts = [
  { label: "Hours", value: "Every day", sub: "9:00 AM – 8:00 PM" },
  { label: "Find us", value: "240 W 98th Street", sub: "Suite 1E, Upper West Side" },
  { label: "Insurance", value: "Most major plans", sub: "Verified before your visit" },
];
---
<section id="about" class="section bg-ivory">
  <Watermark class="-right-28 top-6 h-[520px] w-[760px] rotate-[-8deg]" />

  <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
    <!-- One photo, framed by a fine gold line -->
    <FadeIn client:visible className="lg:col-span-5">
      <figure class="mx-auto max-w-[34rem] lg:mx-0">
        <div class="group/photo relative">
          <span aria-hidden="true" class="absolute inset-0 -z-10 translate-x-5 translate-y-5 rounded-[1.75rem] border border-gold/70 transition-all duration-500 ease-out group-hover/photo:translate-x-8 group-hover/photo:translate-y-8 group-hover/photo:border-gold"></span>
          <div class="overflow-hidden rounded-[1.75rem] shadow-soft transition-all duration-500 ease-out group-hover/photo:-translate-x-1 group-hover/photo:-translate-y-1 group-hover/photo:shadow-lift">
            <img
              src="/images/Doctors.webp"
              alt="Dr. Rachel Roesner and Dr. Farris Fahmy smiling in the Aster waiting lounge"
              class="img-square transition-transform duration-[900ms] ease-out group-hover/photo:scale-[1.07]"
              style="object-position: 50% 40%"
              loading="lazy"
            />
          </div>
        </div>
        <figcaption class="mt-9 flex items-center gap-4">
          <span class="h-px w-10 bg-gold"></span>
          <span class="text-sm leading-snug text-taupe">
            <span class="block font-display text-base text-espresso">Dr. Rachel Roesner &amp; Dr. Farris Fahmy</span>
            Board-certified OB/GYNs, FACOG
          </span>
        </figcaption>
      </figure>
    </FadeIn>

    <FadeIn client:visible delay={0.1} className="lg:col-span-7">
      <p class="eyebrow">About Aster OB/GYN</p>
      <h2 class="h2 mt-5 max-w-xl">Trusted OB/GYN care on the Upper West Side</h2>

      <p class="mt-8 max-w-2xl text-xl leading-[1.75] text-espresso/90 first-letter:float-left first-letter:pr-3 first-letter:pt-1 first-letter:font-display first-letter:text-[4.4rem] first-letter:leading-[0.78] first-letter:text-terracotta">
        Aster OB/GYN is an independent women's health practice in Manhattan, dedicated to
        comprehensive, compassionate care for women of every age.
      </p>
      <p class="mt-5 max-w-2xl text-espresso/75">
        Because we are independent, you see the same familiar faces and have time to ask your
        questions. From routine check-ups to advanced gynecologic treatment and delivery, your care
        stays personal, and same-day visits are often available. Evening and weekend hours mean care
        fits your life, not the other way around.
      </p>

      <dl class="mt-10 grid max-w-2xl divide-y divide-sand sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {facts.map((f) => (
          <div class="group py-5 sm:px-6 sm:py-1 sm:first:pl-0">
            <dt class="text-[11.5px] font-bold uppercase tracking-[0.22em] text-terracotta">{f.label}</dt>
            <dd class="mt-2 font-display text-xl text-espresso transition-colors duration-300 group-hover:text-terracotta">{f.value}</dd>
            <dd class="mt-0.5 text-[15px] text-taupe">{f.sub}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-11 flex flex-wrap gap-4">
        <a href="/about-practice/" class="btn btn-dark">Read More <Icon name="arrow-right" size={18} /></a>
        <a href="#providers" class="btn btn-outline">Meet Our Doctors</a>
      </div>
    </FadeIn>
  </div>
</section>
