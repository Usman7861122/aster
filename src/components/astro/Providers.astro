---
const { bg = "bg-ivory" } = Astro.props;
import FadeIn from "../react/FadeIn";
import Icon from "./Icon.astro";
import Watermark from "./Watermark.astro";
import { doctors, site } from "../../data/site";
---
<section id="providers" class={`section ${bg}`}>
  <Watermark class="-right-20 bottom-0 h-[520px] w-[760px] rotate-[6deg]" />
  <div class="container-x">
    <FadeIn client:visible className="mx-auto max-w-2xl text-center">
      <p class="eyebrow eyebrow-center">Meet our experts</p>
      <h2 class="h2 mt-5">Two doctors who know your name</h2>
      <p class="mt-5 text-espresso/75">Both are board-certified and affiliated with Mount Sinai West.</p>
    </FadeIn>

    <div class="mx-auto mt-16 grid max-w-5xl gap-8 md:grid-cols-2">
      {doctors.map((d, i) => (
        <FadeIn client:visible delay={i * 0.12}>
          <article class="group h-full overflow-hidden rounded-[2rem] border border-sand/70 bg-white p-4 shadow-soft transition-all duration-500 hover:-translate-y-2 hover:shadow-lift">
            <div class="relative overflow-hidden rounded-3xl">
              <img
                src={d.img}
                alt={`Portrait of ${d.name}`}
                class="img-square transition-transform duration-700 group-hover:scale-105"
                style={`object-position:${d.pos}`}
                loading="lazy"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-espresso/55 to-transparent"></span>
              <span class="absolute bottom-4 left-4 rounded-full bg-white/90 px-4 py-1.5 text-[11.5px] font-bold uppercase tracking-[0.2em] text-terracotta-deep backdrop-blur">
                {d.role}
              </span>
            </div>

            <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4 px-3 pb-3 pt-6">
              <div>
                <h3 class="font-display text-3xl leading-tight">{d.name}</h3>
                <p class="font-display text-lg italic text-taupe">{d.creds}</p>
              </div>
              <div class="flex flex-wrap gap-3">
                <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn-primary btn-glow btn-sm">Book a Visit <Icon name="arrow-right" size={16} /></a>
                <a href="/providers/" class="btn btn-outline btn-sm">View Profile</a>
              </div>
            </div>
          </article>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
