---
import "../styles/global.css";
import Header from "../components/react/Header";
import Footer from "../components/astro/Footer.astro";
import CookieConsent from "../components/react/CookieConsent";

interface Props { title: string; description?: string }
const {
  title,
  description = "Aster OB/GYN is an independent women's health practice on Manhattan's Upper West Side. Same-day visits, evening and weekend hours.",
} = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b1f1b" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header client:load solid={!isHome} />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Third-party scripts go here as <script type="text/plain" data-consent="analytics" src="..."></script>.
         They run only after the visitor allows that cookie category. -->
    <CookieConsent client:idle />
  </body>
</html>
